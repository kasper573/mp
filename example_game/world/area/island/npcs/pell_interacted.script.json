{
  "runs_on": "npc",
  "nodes": {
    "call_guards": {
      "type": "notify",
      "notification": "world/area/island/npcs/pell_calls_guards.notification.json",
      "next": "guards"
    },
    "draw_knife": {
      "type": "notify",
      "notification": "world/area/island/npcs/pell_draws_knife.notification.json",
      "next": "hostile_pell"
    },
    "grudging": {
      "type": "dialogue",
      "lines": [
        {
          "by": {
            "type": "npc",
            "npc": "world/area/island/npcs/pell.npc.json",
            "face": "angry"
          },
          "text": [
            "You've got ",
            {
              "text": "some nerve",
              "voice": "shout"
            },
            ", showing your face at my table."
          ]
        }
      ],
      "choices": [
        {
          "label": [
            "Then let's settle this."
          ],
          "to": "remember_fight"
        },
        {
          "label": [
            "I'm leaving."
          ]
        }
      ]
    },
    "guards": {
      "type": "spawn_npcs",
      "npc": "world/area/island/npcs/harbour_guard.npc.json",
      "count": 2,
      "near": "owner",
      "shown": "subject"
    },
    "hello": {
      "type": "dialogue",
      "lines": [
        {
          "by": {
            "type": "npc",
            "npc": "world/area/island/npcs/pell.npc.json",
            "face": "pell_smirk"
          },
          "text": [
            "Care for a ",
            {
              "text": "little game",
              "motion": "wave"
            },
            "? Ten ",
            {
              "text": "Gold",
              "ink": "item"
            },
            {
              "text": ".",
              "pause_after": 600.0
            },
            {
              "text": " I never cheat.",
              "voice": "whisper"
            }
          ]
        }
      ],
      "choices": [
        {
          "label": [
            "Roll the dice."
          ],
          "reveal": [
            "costs"
          ],
          "to": "stake"
        },
        {
          "label": [
            "Not today."
          ]
        }
      ]
    },
    "holds_grudge": {
      "type": "if",
      "test": {
        "type": "set_within",
        "memory": "world/area/island/npcs/pell_grudge.memory.json",
        "seconds": 1800
      },
      "yes": "grudging",
      "no": "hello"
    },
    "hostile_pell": {
      "type": "spawn_npcs",
      "npc": "world/area/island/npcs/pell_hostile.npc.json",
      "count": 1,
      "near": "owner",
      "shown": "subject"
    },
    "interacted": {
      "type": "on",
      "event": "interacted",
      "verb": "talk",
      "reach": 2.0,
      "marks": [
        "interface/attention/chance.attention.json"
      ],
      "next": "holds_grudge"
    },
    "loses": {
      "type": "dialogue",
      "lines": [
        {
          "by": {
            "type": "npc",
            "npc": "world/area/island/npcs/pell.npc.json",
            "face": "surprised"
          },
          "text": [
            "Bah! Beginner's luck. Twenty ",
            {
              "text": "Gold",
              "ink": "item"
            },
            ", as promised."
          ]
        }
      ],
      "choices": [
        {
          "label": [
            "Roll again."
          ],
          "reveal": [
            "costs"
          ],
          "to": "stake"
        },
        {
          "label": [
            "I'll quit while I'm ahead."
          ]
        }
      ]
    },
    "payout": {
      "type": "items",
      "give": [
        {
          "item": "items-and-skills/item/gold.item.json",
          "count": 20
        }
      ],
      "done": "loses"
    },
    "remember_fight": {
      "type": "remember",
      "memory": "world/area/island/memories/pell_fighting.memory.json",
      "next": "draw_knife"
    },
    "remember_grudge": {
      "type": "remember",
      "memory": "world/area/island/npcs/pell_grudge.memory.json",
      "next": "call_guards"
    },
    "roll": {
      "type": "random",
      "weights": [
        45,
        55
      ],
      "outputs": [
        "payout",
        "wins"
      ]
    },
    "stake": {
      "type": "items",
      "take": [
        {
          "item": "items-and-skills/item/gold.item.json",
          "count": 10
        }
      ],
      "done": "roll"
    },
    "wins": {
      "type": "dialogue",
      "lines": [
        {
          "by": {
            "type": "npc",
            "npc": "world/area/island/npcs/pell.npc.json",
            "face": "happy"
          },
          "text": [
            "The house wins! The dice are ",
            {
              "text": "fickle friends",
              "motion": "wave"
            },
            ", eh?"
          ]
        }
      ],
      "choices": [
        {
          "label": [
            "Roll again."
          ],
          "reveal": [
            "costs"
          ],
          "to": "stake"
        },
        {
          "label": [
            "You're cheating."
          ],
          "to": "remember_grudge"
        },
        {
          "label": [
            "Leave."
          ]
        }
      ]
    }
  }
}
