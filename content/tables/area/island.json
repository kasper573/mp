      "upper"
    ]
  },
  "modules": [
    {
      "type": "object",
      "name": "forest-road",
      "shape": {
        "type": "rect",
        "x": 38.5,
        "y": 25.5,
        "w": 1.0,
        "h": 1.0
      },
      "scripts": [
        {
          "type": "inline_script",
          "nodes": {
            "cross": {
              "type": "warp",
              "to": {
                "area": "forest",
                "x": 3.0,
                "y": 18.0
              }
            },
            "entered": {
              "type": "on",
              "event": "entered",
              "by": "characters",
              "next": "pass"
            },
            "pass": {
              "type": "if",
              "test": {
                "type": "at_least",
                "a": {
                  "type": "holding",
                  "item": "road_pass"
                },
                "b": 1
              },
              "yes": "cross"
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "name": "notice-board",
      "label": "Harbour notices",
      "shape": {
        "type": "point",
        "x": 40.0,
        "y": 19.0
      },
      "look": "icons/misc/scroll.png",
      "scripts": [
        {
          "type": "inline_script",
          "nodes": {
            "interacted": {
              "type": "on",
              "event": "interacted",
              "verb": "read",
              "reach": 1.5,
              "next": "read"
            },
            "read": {
              "type": "dialogue",
              "lines": [
                {
                  "by": {
                    "type": "narrator"
                  },
                  "text": [
                    "Notices flap on the post, nailed over older notices."
                  ]
                },
                {
                  "by": {
                    "type": "object"
                  },
                  "text": [
                    {
                      "text": "FERRY SUSPENDED",
                      "voice": "shout"
                    },
                    " until the orc trouble passes. By order of ",
                    {
                      "text": "Captain Bram",
                      "ink": "name"
                    },
                    "."
                  ]
                },
                {
                  "by": {
                    "type": "object"
                  },
                  "text": [
                    "WANTED: strong arms for the ",
                    {
                      "text": "north shore",
                      "ink": "place"
                    },
                    ". Ask ",
                    {
                      "text": "Mara",
                      "ink": "name"
                    },
                    " at the market."
                  ]
                }
              ],
              "choices": [
                {
                  "label": [
                    "Step away."
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "name": "tide-chest",
      "label": "Tide chest",
      "shape": {
        "type": "point",
        "x": 46.0,
        "y": 29.0
      },
      "look": "icons/misc/chest.png",
      "scripts": [
        {
          "type": "inline_script",
          "nodes": {
            "empty": {
              "type": "dialogue",
              "lines": [
                {
                  "by": {
                    "type": "narrator"
                  },
                  "text": [
                    "Only sand, and a crab that does not appreciate the visit. ",
                    {
                      "text": "The tide brings more each day.",
                      "voice": "whisper"
                    }
                  ]
                }
              ],
              "choices": [
                {
                  "label": [
                    "Close the lid."
                  ]
                }
              ]
            },
            "found": {
              "type": "dialogue",
              "lines": [
                {
                  "by": {
                    "type": "narrator"
                  },
                  "text": [
                    "Wedged between the rocks, the chest is heavy with the tide's leavings."
                  ]
                },
                {
                  "by": {
                    "type": "narrator"
                  },
                  "text": [
                    "You find five ",
                    {
                      "text": "Gold",
                      "ink": "item"
                    },
                    " coins."
                  ]
                }
              ],
              "choices": [
                {
                  "label": [
                    "Close the lid."
                  ]
                }
              ]
            },
            "interacted": {
              "type": "on",
              "event": "interacted",
              "verb": "open",
              "reach": 1.5,
              "next": "map_found"
            },
            "loot": {
              "type": "items",
              "give": [
                {
                  "item": "gold",
                  "count": 5
                }
              ],
              "done": "remember_looted"
            },
            "loot_map": {
              "type": "items",
              "give": [
                {
                  "item": "gold",
                  "count": 5
                },
                {
                  "item": "tattered_map"
                }
              ],
              "done": "remember_map"
            },
            "looted": {
              "type": "if",
              "test": {
                "type": "memory",
                "memory": "tide_chest_looted"
              },
              "yes": "empty",
              "no": "loot"
            },
            "map": {
              "type": "dialogue",
              "lines": [
                {
                  "by": {
                    "type": "narrator"
                  },
                  "text": [
                    "You find five ",
                    {
                      "text": "Gold",
                      "ink": "item"
                    },
                    " coins. Under them, a scrap of oilcloth is wrapped around a ",
                    {
                      "text": "tattered map",
                      "ink": "item"
                    },
                    "."
                  ]
                },
                {
                  "by": {
                    "type": "narrator"
                  },
                  "text": [
                    {
                      "text": "Unfold it from your bag to read it.",
                      "voice": "whisper"
                    }
                  ]
                }
              ],
              "choices": [
                {
                  "label": [
                    "Close the lid."
                  ]
                }
              ]
            },
            "map_found": {
              "type": "if",
              "test": {
                "type": "memory",
                "memory": "found_tattered_map"
              },
              "yes": "looted",
              "no": "loot_map"
            },
            "remember_looted": {
              "type": "remember",
              "memory": "tide_chest_looted",
              "next": "found"
            },
            "remember_looted_map": {
              "type": "remember",
              "memory": "tide_chest_looted",
              "next": "map"
            },
            "remember_map": {
              "type": "remember",
              "memory": "found_tattered_map",
              "next": "remember_looted_map"
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "name": "honesty-box",
      "label": "Honesty box",
      "shape": {
        "type": "point",
        "x": 42.0,
        "y": 26.0
      },
      "look": "icons/misc/crate.png",
      "scripts": [
        {
          "type": "inline_script",
          "nodes": {
            "interacted": {
              "type": "on",
              "event": "interacted",
              "verb": "use",
              "reach": 1.5,
              "next": "note"
            },
            "note": {
              "type": "dialogue",
              "lines": [
                {
                  "by": {
                    "type": "narrator"
                  },
                  "text": [
                    "Fish steaks wrapped in leaves, and a slot for coins. A note in ",
                    {
                      "text": "Tobb",
                      "ink": "name"
                    },
                    "'s hand: ",
                    {
                      "text": "pay what's written.",
                      "voice": "whisper"
                    }
                  ]
                }
              ],
              "next": "shop"
            },
            "shop": {
              "type": "open_shop",
              "shop": "honesty_box"
            }
          }
        }
      ]
    },
    {
